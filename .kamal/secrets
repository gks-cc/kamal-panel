# 本文件入库，只引用环境变量，不放真实值。
# 本地：真实值在仓库根的 .env.production（已 gitignore，0600），由 bin/kamal-prod 加载后再调用 kamal。
# CI：值来自 GitHub 仓库的 Actions secrets（见 .github/workflows/kamal_deploy.yml）。

# 阿里云 ACR（香港）密码，与同机其他应用共用
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# config/master.key 的内容（该文件本身不入库）
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# 覆盖 credentials 里的 secret_key_base（credentials 来自上游 fork，生产用独立值）
SECRET_KEY_BASE=$SECRET_KEY_BASE

# Active Record encryption 三件套（bin/rails db:encryption:init 生成）。
# ⚠️ 丢失后库里已加密的 SSH 私钥等凭据将永久无法解密，务必与 master.key 一起备份。
AR_ENCRYPTION_PRIMARY_KEY=$AR_ENCRYPTION_PRIMARY_KEY
AR_ENCRYPTION_DETERMINISTIC_KEY=$AR_ENCRYPTION_DETERMINISTIC_KEY
AR_ENCRYPTION_KEY_DERIVATION_SALT=$AR_ENCRYPTION_KEY_DERIVATION_SALT
