<div class="auth">
  <div class="auth-card">
    <h1><%= t(".title") %></h1>
    <p class="hint"><%= t(".lead") %></p>

    <%= tag.div(flash[:alert], class: "flash-alert") if flash[:alert] %>
    <% if @user.errors.any? %>
      <div class="flash-alert" role="alert">
        <% @user.errors.full_messages.each do |message| %><div><%= message %></div><% end %>
      </div>
    <% end %>

    <%= form_with model: @user, url: setup_path, method: :post, scope: :user do |form| %>
      <%= hidden_field_tag :token, params[:token] %>
      <div>
        <%= form.label :email_address, t(".email") %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com" %>
      </div>
      <div>
        <%= form.label :password, t(".password") %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
      </div>
      <div>
        <%= form.label :password_confirmation, t(".password_confirmation") %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
      </div>
      <%= form.submit t(".submit"), class: "btn-primary" %>
    <% end %>
  </div>
</div>
